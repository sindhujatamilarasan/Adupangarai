# Production settings for the API. On the server: cp api/.env.production.example api/.env, fill the blanks,
# then run: docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show  (paste into APP_KEY)
APP_NAME=Adupangarai
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://adupangarai.in
FRONTEND_URL=https://adupangarai.in
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Web app + the Android app (Capacitor serves it from https://localhost)
CORS_ALLOWED_ORIGINS=https://adupangarai.in,https://localhost

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Database host/name/user/password come from docker-compose.prod.yml and ../.env
DB_CONNECTION=pgsql

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Login tokens expire after this many minutes (30 days)
SANCTUM_EXPIRATION=43200

# Email (password reset). Brevo free plan: smtp-relay.brevo.com, SMTP login + SMTP key from Brevo → SMTP & API.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@adupangarai.in
MAIL_FROM_NAME=Adupangarai

# AI (Google Gemini free tier) — key from aistudio.google.com
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_FALLBACK_MODEL=gemini-flash-lite-latest
AI_TIMEOUT=60

# Google sign-in (Web client ID)
GOOGLE_CLIENT_ID=

# Shown on /privacy, /terms and /delete-account
CONTACT_EMAIL=sindhujatamilarasan@gmail.com
DEVELOPER_NAME="Sindhuja Tamilarasan"

# Error alerts (optional): DSN from sentry.io → project → Client Keys
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
